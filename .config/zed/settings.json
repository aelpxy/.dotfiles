{
  "theme": {
    "mode": "system",
    "light": "Zedokai Darker (Filter Spectrum)",
    "dark": "Zedokai Darker (Filter Spectrum)",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 16,
  "ui_font_size": 16,
  "show_whitespaces": "all",
  "base_keymap": "VSCode",
  "vim_mode": false,
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "cli_default_open_behavior": "existing_window",
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "project_panel": {
    "dock": "left",
    "git_status_indicator": true,
    "show_diagnostics": "errors",
    "diagnostic_badges": false,
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "file_icons": true,
    "tree_view": false,
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "status_bar": {
    "line_endings_button": false,
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "accessible_mode": true,
}
